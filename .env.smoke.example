# Minimal required env for release verification.
# With only SMOKE_API_BASE_URL present, the command runs:
# - /healthz
# - /readyz
# and skips authenticated smoke checks.
SMOKE_API_BASE_URL=https://api-staging-qvmv.onrender.com

# Optional. When present, release verification also runs direct DB schema sanity checks.
# If absent, the command relies on /readyz for schema readiness and marks direct schema check skipped.
# DATABASE_URL=postgres://...

# Optional authenticated smoke checks.
SMOKE_BUSINESS_BEARER_TOKEN=replace_me
SMOKE_DRIVER_BEARER_TOKEN=replace_me_optional
SMOKE_ADMIN_BEARER_TOKEN=replace_me_optional

# Optional browser smoke credentials. Do not commit real passwords.
STAGING_WEB_BASE_URL=https://ondemand-logistics-platform-web.vercel.app
SMOKE_LATEST_ORDER_ID=replace_me_optional
# Set true for release/full smoke mode. Missing tracking/auth credentials fail instead of skipping.
SMOKE_REQUIRE_AUTH=false
SMOKE_BUSINESS_EMAIL=smoke-business@shipwright.example.com
SMOKE_BUSINESS_PASSWORD=replace_me
SMOKE_ADMIN_EMAIL=smoke-admin@shipwright.example.com
SMOKE_ADMIN_PASSWORD=replace_me
SMOKE_DRIVER_EMAIL=smoke-driver@shipwright.example.com
SMOKE_DRIVER_PASSWORD=replace_me
SMOKE_FLEET_MANAGER_EMAIL=smoke-fleet-manager@shipwright.example.com
SMOKE_FLEET_MANAGER_PASSWORD=replace_me
